<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SpatialStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
    </style>

    <style name="Theme.SpatialStudio.Scan">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- A small round icon button for the scan screen's top bar; selected means on. -->
    <style name="ScanIconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
