<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/scan_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/scan_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/hud_scrim"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_starting"
            android:textColor="@color/brand_foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scan_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/scan_sensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/scan_heading_wait"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/scan_toggle_sensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/scan_toggle_sensors"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/scan_toggle_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_toggle_location"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/scan_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/scan_hint"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scan_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/hud_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/scan_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/scan_cancel" />

        <Button
            android:id="@+id/scan_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/scan_finish" />
    </LinearLayout>
</FrameLayout>
