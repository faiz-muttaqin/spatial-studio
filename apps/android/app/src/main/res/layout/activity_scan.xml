<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/scan_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/scan_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/hud_scrim"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_starting"
            android:textColor="@color/brand_foreground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scan_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/scan_sensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/scan_heading_wait"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/scan_toggle_sensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/scan_toggle_sensors"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/scan_toggle_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_toggle_location"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/scan_toggle_torch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_toggle_torch"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/scan_guidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/scan_floor_waiting"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scan_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/scan_hint"
            android:textColor="@color/brand_foreground"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scan_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/hud_scrim"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/scan_mark_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/scan_mark_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mark_tap_start"
                android:textColor="@color/brand_foreground"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/scan_mark_kind"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/mark_kind_label" />

                <EditText
                    android:id="@+id/scan_mark_height"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:autofillHints="@null"
                    android:hint="@string/mark_height_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="6"
                    android:textColor="@color/brand_foreground"
                    android:textColorHint="@color/brand_foreground"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/scan_mark_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/mark_confirm" />

                <Button
                    android:id="@+id/scan_mark_undo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/mark_undo" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/scan_mark_ceiling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/mark_to_ceiling"
                android:textColor="@color/brand_foreground"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scan_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/scan_cancel" />

            <Button
                android:id="@+id/scan_mark_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.3"
                android:enabled="false"
                android:text="@string/mark_start" />

            <Button
                android:id="@+id/scan_finish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/scan_finish" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
